{
  "name": "research-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @research/web dev",
    "build": "pnpm --filter @research/web build",
    "lint": "pnpm --filter @research/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @research/web test:watch",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "try-search": "pnpm --filter @research/web try-search",
    "try-extract": "pnpm --filter @research/web try-extract"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
