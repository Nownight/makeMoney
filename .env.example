# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Web)
# Use the Project URL and the public "publishable" / "anon" key from
# Supabase Dashboard -> Project Settings -> API. Both are safe to expose.
# Never put the service role key in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required from Phase 3: the server writes report status and
# sources with it (bypasses RLS). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# ScrapeGraphAI (Phase 3+)
# ---------------------------------------------------------------------------
SGAI_API_KEY=

# ---------------------------------------------------------------------------
# LLM analysis (Phase 5+), server-only. Any OpenAI-compatible Chat
# Completions endpoint works: OpenAI, DeepSeek or a relay (中转).
# LLM_BASE_URL defaults to https://api.openai.com/v1
#   e.g. https://api.deepseek.com/v1 or https://your-relay.example.com/v1
# ANALYSIS_MODEL is required, e.g. gpt-4o-mini / deepseek-chat
# ---------------------------------------------------------------------------
LLM_BASE_URL=
OPENAI_API_KEY=
ANALYSIS_MODEL=

# ---------------------------------------------------------------------------
# Payments (Phase 9+)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REPORT_PRICE=
